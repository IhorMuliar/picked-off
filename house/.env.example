# House runner settings (every key optional; defaults per CLUSTER in house/src/config.ts).
CLUSTER=devnet
BASE_RPC=https://rpc.magicblock.app/devnet
ER_RPC=https://devnet-tee.magicblock.app
VALIDATOR=MTEWGuqxUpYZGFJQcp8tLN7x5v9BSeoFHYWQQ3n3xzo
POOLS=1,2
HOUSE_KEYPAIR=/opt/picked-off/keys/house.json
BOT_KEYS_DIR=/opt/picked-off/keys/bots
STATE_DIR=/var/lib/picked-off
RECORD_EVERY_SEC=300
TEST_CALLS=0
LIGHTS_ON_MS=8000
STALL_MS=3000
HARD_STALL_MS=20000
MAX_ROUND_MS=120000
HEALTH_PORT=8788
# no new records below this house balance (rounds keep playing unrecorded)
MIN_BALANCE_SOL=6
# below this balance a pool records at most one round per LOW_RECORD_EVERY_SEC, even with players seated
SOFT_BALANCE_SOL=10
LOW_RECORD_EVERY_SEC=120
# a base tx with no status after this long (and an expired blockhash) is sent again
BASE_DROP_MS=90000
# logs in STATE_DIR rotate at this size, keeping HOUSE_LOG_KEEP older files
HOUSE_LOG_MAX_MB=100
HOUSE_LOG_KEEP=3
# the account-read log for the privacy check (about 4 MB per pool-hour); "off" disables it
# HOUSE_RPC_LOG=off
# optional: a JSON file with the same settings (camelCase keys), applied before the environment
# HOUSE_CONFIG=/opt/picked-off/house.json
